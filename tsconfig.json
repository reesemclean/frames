{
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "~/*": ["./src/*"] }
  },
  "include": ["src", "tests", "vite.config.ts", "vitest.config.ts", "drizzle.config.ts"]
}
